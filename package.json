{
  "name": "@mcpaql/adapter-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Schema builder and adapter generator for MCP-AQL",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "mcpaql-schema-build": "./dist/schema-cli.js",
    "mcpaql-generate-adapter": "./dist/generate-cli.js"
  },
  "scripts": {
    "build": "npm run build -w @mcpaql/adapter-generator-core && tsc -p tsconfig.json",
    "test": "npm run build -w @mcpaql/adapter-generator-core && node --import tsx --test \"test/**/*.test.ts\"",
    "schema:build": "tsx src/schema-cli.ts",
    "generate": "tsx src/generate-cli.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@mcpaql/adapter-generator-core": "file:packages/adapter-generator-core"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
